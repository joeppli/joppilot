# M3-4b — cloud live-telemetry mode (OPTIONAL).
# Copy to .env.local (git-ignored) and fill from the terraform outputs to make
# the console subscribe to LIVE telemetry straight from AWS IoT Core over WSS.
# Leave .env.local absent for the pure-localhost console (default behaviour).
#
# Values (Actions apply log `Outputs:` block, or: terraform output <name>):
#   VITE_COGNITO_USER_POOL_ID  = cognito_user_pool_id
#   VITE_COGNITO_CLIENT_ID     = cognito_client_id
#   VITE_COGNITO_DOMAIN        = cognito_hosted_ui_domain WITHOUT the "https://"
#                                (host only, e.g. joppilot-dev-<acct>.auth.eu-central-1.amazoncognito.com)
#   VITE_IDENTITY_POOL_ID      = console_identity_pool_id
#   VITE_AWS_IOT_ENDPOINT      = iot_endpoint
#
# DEV-23 (one-time per operator): after the FIRST sign-in attach the IoT policy
# to your identity — find the id in the browser console error or:
#   aws cognito-identity list-identities --identity-pool-id <VITE_IDENTITY_POOL_ID> \
#     --max-results 10 --region eu-central-1
#   aws iot attach-policy --policy-name joppilot-dev-console-viewer \
#     --target <identityId> --region eu-central-1

VITE_AWS_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_IDENTITY_POOL_ID=
VITE_AWS_IOT_ENDPOINT=
