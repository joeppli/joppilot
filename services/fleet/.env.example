# services/fleet — copy to .env (`cp .env.example .env`)
# Matches the credentials in infra/docker-compose.yml (postgres service).
# NOTE: command and fleet share ONE database with SEPARATE Postgres schemas —
# the ?schema= suffix is what isolates them (see README "database & migrations").
DATABASE_URL="postgresql://joppilot:joppilot_secret@localhost:5432/joppilot_db?schema=fleet"
