# services/command — copy to .env (`cp .env.example .env`)
# Matches the credentials in infra/docker-compose.yml (postgres service).
# NOTE: command and fleet share ONE database with SEPARATE Postgres schemas —
# the ?schema= suffix is what isolates them (see README "database & migrations").
DATABASE_URL="postgresql://joppilot:joppilot_secret@localhost:5432/joppilot_db?schema=command"

# --- Optional (defaults suit the bare-metal local setup) ---
# MQTT_HOST=localhost        # plain-MQTT broker host (containers: the broker's DNS name)
# MQTT_PORT=1883
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_TLS=false            # true for ElastiCache in-transit encryption (M2-4)
# AWS_IOT_ENDPOINT=          # set (with the AWS_CERT_*_PATH vars) to switch to IoT Core mTLS (M2-5)
