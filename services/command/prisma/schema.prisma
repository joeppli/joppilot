generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  // native = the machine you develop on; linux-musl-openssl-3.0.x = the
  // node:22-alpine docker runtime. Pinning both keeps the docker image from
  // depending on build-time engine auto-detection.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: Telemetry is no longer persisted via Prisma. The telemetry hot-path uses
// raw batched inserts in the telemetry service (Architecture AD-14). The command
// service owns only the EDR/audit table below, so this is now the single Prisma
// schema in the monorepo (no shared-client duplication).
// APPEND-ONLY (LEG-04/SEC-06, August EDR design note in the timeline): a
// status transition is written as a NEW record, never an in-place update —
// the Postgres EDR is the queryable working copy of an audit trail whose
// immutable evidence copy lands in S3 Object Lock (August). commandId is
// therefore a correlation key, NOT unique: one command yields one PENDING
// row plus one row per ACK/NACK/status transition.
model EventDataRecord {
  id          String   @id @default(uuid())
  commandId   String
  vehicleId   String
  issuer      String
  action      String
  status      String   // e.g. "PENDING", "ACK", "REJECTED"
  details     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([commandId])
}
