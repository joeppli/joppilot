# =============================================================================
# PC-A (CARLA machine) config for ./run-vehicle.sh
#
# The JOPPILOT OPERATOR fills this in ONCE (values come from AWS, fetched in
# CloudShell — see below), then hands THIS FILE + the 3 certificate files to
# the engineer on the CARLA machine. Copy to `vehicle.env` next to run-vehicle.sh:
#     cp edge/vehicle.env.example edge/vehicle.env   &&  edit it
# =============================================================================

# --- AWS IoT endpoint (the host the vehicle connects to) ---------------------
# CloudShell:  aws iot describe-endpoint --endpoint-type iot:Data-ATS \
#                --region eu-central-1 --query endpointAddress --output text
IOT_ENDPOINT=

# --- Cloud signing PUBLIC key the vehicle pins (ICD §4) ----------------------
# MUST match the key the CLOUD command service signs with. Fetch its public
# half from Secrets Manager (CloudShell):
#   aws secretsmanager get-secret-value --secret-id joppilot-dev-command-signing-key \
#     --query SecretString --output text --region eu-central-1 \
#     | openssl pkey -pubout -outform DER | tail -c 32 | base64
# (NOT the committed dev key — a mismatch makes the kernel NACK every command.)
EDGE_CLOUD_PUBKEY=

# --- Where the engineer put the 3 vehicle certificate files ------------------
# The folder must contain: veh.cert.pem  veh.key.pem  veh.ca.pem
# (Fetch once from Secrets Manager id `joppilot-dev-iot-vehicle-VEH-001` and
#  send the 3 files to the engineer — see edge/README-vehicle.md.)
CERT_DIR=./certs

# --- CARLA simulator on the engineer's machine -------------------------------
CARLA_HOST=127.0.0.1
CARLA_PORT=2000

# --- Optional ----------------------------------------------------------------
# VEHICLE_ID=VEH-001         # must equal the provisioned IoT thing name
# CARLA_MOCK=0               # 1 = kinematic mock (no CARLA / no carla wheel) —
#                            #     handy to prove the cloud link before wiring CARLA
